{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orbital.camera-rig/1.0",
  "title": "Orbital camera rig state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "transport",
    "hardwareWriteEnabled",
    "physicalMeasurement",
    "profileId",
    "state",
    "discoveredCount",
    "activeCount",
    "targetCount",
    "devices",
    "flags"
  ],
  "properties": {
    "schemaVersion": { "const": "orbital.camera-rig/1.0" },
    "transport": { "enum": ["genicam-gigevision", "gmsl2", "vendor-sdk", "synthetic"] },
    "hardwareWriteEnabled": { "const": false },
    "physicalMeasurement": { "const": false },
    "profileId": { "type": "string", "minLength": 1 },
    "state": { "enum": ["offline", "discovered", "configured", "armed", "streaming", "fault"] },
    "discoveredCount": { "type": "integer", "minimum": 0 },
    "activeCount": { "type": "integer", "minimum": 0 },
    "targetCount": { "type": "integer", "minimum": 1, "maximum": 16 },
    "devices": {
      "type": "array",
      "items": { "$ref": "#/$defs/device" }
    },
    "flags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "index",
        "label",
        "profileId",
        "state",
        "frameCount",
        "droppedFrames",
        "fps",
        "latencyMs",
        "lastFrameAgeMs",
        "exposureUs",
        "gainDb",
        "triggerMode",
        "flags"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "index": { "type": "integer", "minimum": 0 },
        "label": { "type": "string", "minLength": 1 },
        "profileId": { "type": "string", "minLength": 1 },
        "state": { "enum": ["offline", "discovered", "configured", "armed", "streaming", "fault"] },
        "frameCount": { "type": "integer", "minimum": 0 },
        "droppedFrames": { "type": "integer", "minimum": 0 },
        "fps": { "type": "number", "minimum": 0 },
        "latencyMs": { "type": "number", "minimum": 0 },
        "lastFrameAgeMs": { "type": "number", "minimum": 0 },
        "exposureUs": { "type": "number", "exclusiveMinimum": 0 },
        "gainDb": { "type": "number" },
        "triggerMode": { "enum": ["hardware", "free-run"] },
        "flags": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
