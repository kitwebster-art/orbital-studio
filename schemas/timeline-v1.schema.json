{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orbital.timeline/1.0",
  "title": "Orbital Studio neutral timeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "beatsPerBar", "barsPerPhrase", "durationBeats", "loop", "tracks"],
  "properties": {
    "schemaVersion": { "const": "orbital.timeline/1.0" },
    "title": { "type": "string", "minLength": 1 },
    "tempoBpm": { "type": "number", "exclusiveMinimum": 0 },
    "bpm": { "type": "number", "exclusiveMinimum": 0 },
    "beatsPerBar": { "type": "integer", "minimum": 1 },
    "barsPerPhrase": { "type": "integer", "minimum": 1 },
    "durationBeats": { "type": "number", "exclusiveMinimum": 0 },
    "loop": { "type": "boolean" },
    "tracks": {
      "type": "array",
      "items": { "$ref": "#/$defs/track" }
    }
  },
  "anyOf": [
    { "required": ["tempoBpm"] },
    { "required": ["bpm"] }
  ],
  "$defs": {
    "value": {
      "oneOf": [
        { "type": ["number", "string", "boolean", "null"] },
        { "type": "array", "items": { "$ref": "#/$defs/value" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } }
      ]
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "beat", "value"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "beat": { "type": "number", "minimum": 0 },
        "value": { "$ref": "#/$defs/value" },
        "interpolation": {
          "enum": ["step", "linear", "smoothstep", "ease-in", "ease-out"]
        },
        "durationBeats": { "type": "number", "minimum": 0 },
        "payload": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/value" }
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cues"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "kind": { "enum": ["value", "event"] },
        "cues": { "type": "array", "items": { "$ref": "#/$defs/cue" } }
      }
    }
  }
}
