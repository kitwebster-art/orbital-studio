{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbital.local/schema/show-score-v1.schema.json",
  "title": "Orbital Show Score v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "durationS",
    "loop",
    "movements"
  ],
  "properties": {
    "schemaVersion": {
      "const": "orbital.show-score/1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "durationS": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "loop": {
      "type": "boolean"
    },
    "movements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/movement"
      }
    }
  },
  "$defs": {
    "unitParameter": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "energy",
        "brightness",
        "visualDensity",
        "fluidity",
        "fracture",
        "glitch",
        "organic",
        "melody",
        "sub",
        "spatialMotion",
        "residualGain",
        "predictionVisibility",
        "fanCue"
      ],
      "properties": {
        "energy": { "$ref": "#/$defs/unitParameter" },
        "brightness": { "$ref": "#/$defs/unitParameter" },
        "visualDensity": { "$ref": "#/$defs/unitParameter" },
        "fluidity": { "$ref": "#/$defs/unitParameter" },
        "fracture": { "$ref": "#/$defs/unitParameter" },
        "glitch": { "$ref": "#/$defs/unitParameter" },
        "organic": { "$ref": "#/$defs/unitParameter" },
        "melody": { "$ref": "#/$defs/unitParameter" },
        "sub": { "$ref": "#/$defs/unitParameter" },
        "spatialMotion": { "$ref": "#/$defs/unitParameter" },
        "residualGain": { "$ref": "#/$defs/unitParameter" },
        "predictionVisibility": { "$ref": "#/$defs/unitParameter" },
        "fanCue": { "$ref": "#/$defs/unitParameter" }
      }
    },
    "localPeak": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at"],
      "properties": {
        "at": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "energy": { "$ref": "#/$defs/unitParameter" },
        "brightness": { "$ref": "#/$defs/unitParameter" },
        "visualDensity": { "$ref": "#/$defs/unitParameter" },
        "fluidity": { "$ref": "#/$defs/unitParameter" },
        "fracture": { "$ref": "#/$defs/unitParameter" },
        "glitch": { "$ref": "#/$defs/unitParameter" },
        "organic": { "$ref": "#/$defs/unitParameter" },
        "melody": { "$ref": "#/$defs/unitParameter" },
        "sub": { "$ref": "#/$defs/unitParameter" },
        "spatialMotion": { "$ref": "#/$defs/unitParameter" },
        "residualGain": { "$ref": "#/$defs/unitParameter" },
        "predictionVisibility": { "$ref": "#/$defs/unitParameter" },
        "fanCue": { "$ref": "#/$defs/unitParameter" }
      }
    },
    "movement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "startS",
        "durationS",
        "majorPeak",
        "description",
        "start",
        "end"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "startS": {
          "type": "number",
          "minimum": 0
        },
        "durationS": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "majorPeak": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "$ref": "#/$defs/parameters"
        },
        "end": {
          "$ref": "#/$defs/parameters"
        },
        "localPeak": {
          "$ref": "#/$defs/localPeak"
        }
      }
    }
  }
}
